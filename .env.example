# ==============================================================================
# 1. ROOT API SETTINGS (FastAPI ML Backend Engine)
# ==============================================================================

# Speech-to-Text API configuration
# (Leave empty / use default string to run in local Mock STT mode)
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Hugging Face serverless API Token for Gemma-2-9b-it completions
# (Leave empty / use default string to run in local Mock LLM mode)
HF_TOKEN=your_huggingface_api_token_here

# Qdrant Database settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=msmarco_xi

# FastAPI Server configurations
PORT=8000
HOST=127.0.0.1


# ==============================================================================
# 2. NEXT.JS PORTAL FRONTEND VARIABLES (Copy these to portal/.env)
# ==============================================================================

# PostgreSQL database URI logic logs persistence
# (Missing/Default value triggers in-memory logging mocks automatically)
DATABASE_URL=postgres://username:password@your-database-host:5432/voicerag?sslmode=require

# NextAuth secret used to encrypt session tokens
NEXTAUTH_SECRET=a_random_32_character_string_for_auth_tokens

# Supabase JS SDK client credentials
NEXT_PUBLIC_SUPABASE_URL=https://naufuzhtwvvufcpvasij.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COkIOg2R5vwtZCI0ROlDhA_h8Ex0rHB
